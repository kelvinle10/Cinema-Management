<Window x:Class="CinemaManagementSystem.Views.Customer.MyBookingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cinema - My Bookings"
        Height="750"
        Width="1200"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#101018">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="30,25,30,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- BACK BUTTON -->
            <Button Grid.Column="0"
            Content="← Back"
            Width="110"
            Height="40"
            Margin="0,0,25,0"
            Background="#252535"
            Foreground="White"
            BorderBrush="#444455"
            FontWeight="Bold"
            Click="btnBack_Click"/>

            <!-- TITLE -->
            <StackPanel Grid.Column="1"
                VerticalAlignment="Center">
                <TextBlock Text="MY BOOKINGS"
                   Foreground="#D9A441"
                   FontSize="26"
                   FontWeight="Bold"/>

                <TextBlock Text="View and manage your movie bookings."
                   Foreground="#AAAAAA"
                   FontSize="14"
                   Margin="0,7,0,0"/>
            </StackPanel>
        </Grid>

        <!-- SEARCH AND FILTER -->
        <Grid Grid.Row="1" Margin="30,0,30,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <!-- SEARCH -->
            <TextBox x:Name="txtSearch"
                     Height="40"
                     Background="#252535"
                     Foreground="White"
                     BorderBrush="#444455"
                     Padding="12,0"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     TextChanged="txtSearch_TextChanged"/>

            <!-- STATUS FILTER -->
            <ComboBox x:Name="cbStatusFilter"
                      Grid.Column="1"
                      Height="40"
                      Margin="12,0,0,0"
                      SelectedIndex="0"
                      Background="#252535"
                      Foreground="White"
                      BorderBrush="#444455"
                      Padding="0"
                      SelectionChanged="cbStatusFilter_SelectionChanged">

                <ComboBox.Template>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton
                                Background="#252535"
                                BorderBrush="#444455"
                                BorderThickness="1"
                                Focusable="False"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsChecked="{Binding IsDropDownOpen,
                                    Mode=TwoWay,
                                    RelativeSource={RelativeSource TemplatedParent}}">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter
                                        Grid.Column="0"
                                        Margin="12,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Content="{Binding SelectionBoxItem,
                                            RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        TextElement.Foreground="White"/>

                                    <TextBlock Grid.Column="1"
                                               Text="▼"
                                               Foreground="#D9A441"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">

                                <Border Background="#252535"
                                        BorderBrush="#444455"
                                        BorderThickness="1"
                                        Width="{Binding ActualWidth,
                                            RelativeSource={RelativeSource AncestorType=ComboBox}}">

                                    <ScrollViewer MaxHeight="200">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </ComboBox.Template>

                <ComboBox.Resources>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#252535"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="12,9"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>

                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#3A3A4D"/>
                                <Setter Property="Foreground" Value="#D9A441"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3A3A4D"/>
                                <Setter Property="Foreground" Value="#D9A441"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Resources>

                <ComboBoxItem Content="All Status"/>
                <ComboBoxItem Content="Pending"/>
                <ComboBoxItem Content="Confirmed"/>
                <ComboBoxItem Content="Cancelled"/>
                <ComboBoxItem Content="Expired"/>

            </ComboBox>

            <!-- REFRESH -->
            <Button Grid.Column="2"
                    Content="Refresh"
                    Height="40"
                    Margin="12,0,0,0"
                    Background="#D9A441"
                    Foreground="#101018"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="btnRefresh_Click"/>
        </Grid>

        <!-- BOOKING TABLE -->
        <Border Grid.Row="2"
                Margin="30,0,30,25"
                Background="#1C1C28"
                CornerRadius="10"
                BorderBrush="#303040"
                BorderThickness="1"
                Padding="15">

            <DataGrid x:Name="dgBookings"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Background="#1C1C28"
                      Foreground="White"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#353545"
                      RowBackground="#1C1C28"
                      AlternatingRowBackground="#252535"
                      HeadersVisibility="Column"
                      RowHeight="55"
                      ColumnHeaderHeight="45"
                      SelectionMode="Single">

                <!-- COLUMN HEADER STYLE -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#252535"/>
                        <Setter Property="Foreground" Value="#D9A441"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- COLUMNS -->
                <DataGrid.Columns>

                    <DataGridTextColumn Header="Booking Code"
                                        Binding="{Binding BookingCode}"
                                        Width="1.3*"/>

                    <DataGridTextColumn Header="Movie"
                                        Binding="{Binding MovieTitle}"
                                        Width="1.5*"/>

                    <DataGridTextColumn Header="Showtime"
                                        Binding="{Binding StartTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                        Width="1.4*"/>

                    <DataGridTextColumn Header="Seats"
                                        Binding="{Binding Seats}"
                                        Width="1.2*"/>

                    <DataGridTextColumn Header="Total Amount"
                                        Binding="{Binding TotalAmount, StringFormat={}{0:N0} VND}"
                                        Width="1.3*"/>

                    <DataGridTextColumn Header="Payment"
                                        Binding="{Binding PaymentStatus}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="*"/>

                    <DataGridTemplateColumn Header="Action" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Details"
                                        Background="#D9A441"
                                        Foreground="#101018"
                                        FontWeight="Bold"
                                        BorderThickness="0"
                                        Padding="12,6"
                                        Cursor="Hand"
                                        Click="btnDetails_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>