<Window x:Class="CinemaManagementSystem.Views.Customer.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payment"
        Height="680"
        Width="850"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#101018">

    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="CINEMA"
                       Foreground="#D9A441"
                       FontSize="28"
                       FontWeight="Bold"/>

            <TextBlock Text="PAYMENT"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,12,0,5"/>

            <TextBlock Text="Review your booking and confirm payment."
                       Foreground="#AAAAAA"
                       FontSize="14"/>
        </StackPanel>

        <!-- Booking Information -->
        <Border Grid.Row="1"
                Background="#1C1C28"
                CornerRadius="12"
                Padding="25">

            <StackPanel>
                <TextBlock Text="BOOKING INFORMATION"
                           Foreground="#D9A441"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <!-- Booking Code -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Booking Code"
                               Foreground="#AAAAAA"/>

                    <TextBlock x:Name="txtBookingCode"
                               Grid.Column="1"
                               Foreground="White"
                               FontWeight="Bold"/>
                </Grid>

                <!-- Movie -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Movie"
                               Foreground="#AAAAAA"/>

                    <TextBlock x:Name="txtMovie"
                               Grid.Column="1"
                               Foreground="White"
                               TextWrapping="Wrap"/>
                </Grid>

                <!-- Showtime -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Showtime"
                               Foreground="#AAAAAA"/>

                    <TextBlock x:Name="txtShowtime"
                               Grid.Column="1"
                               Foreground="White"/>
                </Grid>

                <!-- Room -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Room"
                               Foreground="#AAAAAA"/>

                    <TextBlock x:Name="txtRoom"
                               Grid.Column="1"
                               Foreground="White"/>
                </Grid>

                <!-- Selected Seats -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Selected Seats"
                               Foreground="#AAAAAA"/>

                    <TextBlock x:Name="txtSeats"
                               Grid.Column="1"
                               Foreground="White"
                               TextWrapping="Wrap"/>
                </Grid>

                <!-- Payment Method -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Payment Method"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center"/>

                    <ComboBox x:Name="cbPaymentMethod"
                              Grid.Column="1"
                              Height="35"
                              SelectedIndex="0"
                              Background="#252535"
                              Foreground="White"
                              BorderBrush="#444455"
                              Padding="0">

                        <ComboBox.Template>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid>

                                    <!-- Main ComboBox -->
                                    <ToggleButton
                                        Background="#252535"
                                        BorderBrush="#444455"
                                        BorderThickness="1"
                                        Focusable="False"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        IsChecked="{Binding IsDropDownOpen,
                                            Mode=TwoWay,
                                            RelativeSource={RelativeSource TemplatedParent}}">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Selected Item -->
                                            <ContentPresenter
                                                Grid.Column="0"
                                                Margin="8,0,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Content="{Binding SelectionBoxItem,
                                                    RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                TextElement.Foreground="White"/>

                                            <!-- Arrow -->
                                            <TextBlock Grid.Column="1"
                                                       Text="▼"
                                                       Foreground="#D9A441"
                                                       FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </ToggleButton>

                                    <!-- Dropdown List -->
                                    <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                           Placement="Bottom"
                                           AllowsTransparency="True"
                                           Focusable="False"
                                           PopupAnimation="Slide">

                                        <Border Background="#252535"
                                                BorderBrush="#444455"
                                                BorderThickness="1">

                                            <ScrollViewer MaxHeight="200">
                                                <StackPanel IsItemsHost="True"/>
                                            </ScrollViewer>

                                        </Border>
                                    </Popup>

                                </Grid>
                            </ControlTemplate>
                        </ComboBox.Template>

                        <!-- Dropdown Item Style -->
                        <ComboBox.Resources>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#252535"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="8,8"/>

                                <Style.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter Property="Background" Value="#3A3A4D"/>
                                        <Setter Property="Foreground" Value="#D9A441"/>
                                    </Trigger>

                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#3A3A4D"/>
                                        <Setter Property="Foreground" Value="#D9A441"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Resources>

                        <ComboBoxItem Content="Demo"/>
                        <ComboBoxItem Content="Cash"/>
                        <ComboBoxItem Content="Bank Transfer"/>
                        <ComboBoxItem Content="E-Wallet"/>

                    </ComboBox>
                </Grid>

                <Separator Background="#444455"
                           Margin="0,5,0,20"/>

                <!-- Total Payment -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="TOTAL PAYMENT"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="txtTotalAmount"
                               Grid.Column="1"
                               Foreground="#D9A441"
                               FontSize="24"
                               FontWeight="Bold"/>
                </Grid>

            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,25,0,0">

            <Button Content="Cancel"
                    Width="120"
                    Height="42"
                    Background="#333344"
                    Foreground="White"
                    BorderThickness="0"
                    Margin="0,0,12,0"
                    Click="btnCancel_Click"/>

            <Button Content="Confirm Payment"
                    Width="180"
                    Height="42"
                    Background="#D9A441"
                    Foreground="#101018"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="btnConfirmPayment_Click"/>
        </StackPanel>

    </Grid>
</Window>
