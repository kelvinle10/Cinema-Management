<Window x:Class="CinemaManagementSystem.Views.Customer.MyProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Profile"
        Height="700"
        Width="850"
        MinHeight="650"
        MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Background="#101018">

    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="MY PROFILE"
                       Foreground="#D9A441"
                       FontSize="26"
                       FontWeight="Bold"/>

            <TextBlock Text="View and update your personal information."
                       Foreground="#AAAAAA"
                       FontSize="14"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- PROFILE FORM -->
        <Border Grid.Row="1"
                Background="#1C1C28"
                CornerRadius="12"
                Padding="30"
                BorderBrush="#303040"
                BorderThickness="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- FULL NAME -->
                    <TextBlock Text="Full Name"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="txtFullName"
                             Height="42"
                             Background="#252535"
                             Foreground="White"
                             BorderBrush="#444455"
                             Padding="12"
                             FontSize="14"
                             Margin="0,0,0,20"/>

                    <!-- USERNAME -->
                    <TextBlock Text="Username"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="txtUsername"
                             Height="42"
                             Background="#252535"
                             Foreground="#AAAAAA"
                             BorderBrush="#444455"
                             Padding="12"
                             FontSize="14"
                             IsReadOnly="True"
                             Margin="0,0,0,20"/>

                    <!-- EMAIL -->
                    <TextBlock Text="Email"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="txtEmail"
                             Height="42"
                             Background="#252535"
                             Foreground="White"
                             BorderBrush="#444455"
                             Padding="12"
                             FontSize="14"
                             Margin="0,0,0,20"/>

                    <!-- PHONE -->
                    <TextBlock Text="Phone"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="txtPhone"
                             Height="42"
                             Background="#252535"
                             Foreground="White"
                             BorderBrush="#444455"
                             Padding="12"
                             FontSize="14"
                             Margin="0,0,0,20"/>

                    <!-- DATE OF BIRTH -->
                    <TextBlock Text="Date of Birth"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <DatePicker x:Name="dpDateOfBirth"
            Height="42"
            Background="#252535"
            Foreground="White"
            BorderBrush="#444455"
            Padding="8"
            Margin="0,0,0,20">

                        <DatePicker.Resources>
                            <Style TargetType="DatePickerTextBox">
                                <Setter Property="Background" Value="#252535"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#444455"/>
                                <Setter Property="CaretBrush" Value="White"/>
                            </Style>

                            <Style TargetType="Calendar">
                                <Setter Property="Background" Value="#252535"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Style>

                            <Style TargetType="CalendarItem">
                                <Setter Property="Background" Value="#252535"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Style>

                            <Style TargetType="CalendarDayButton">
                                <Setter Property="Background" Value="#252535"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#252535"/>
                            </Style>

                            <Style TargetType="CalendarButton">
                                <Setter Property="Background" Value="#252535"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </DatePicker.Resources>
                        </DatePicker>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- BUTTONS -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Back"
                    Width="110"
                    Height="42"
                    Margin="0,0,12,0"
                    Background="#252535"
                    Foreground="White"
                    BorderBrush="#444455"
                    FontWeight="Bold"
                    Click="btnBack_Click"/>

            <Button Grid.Column="2"
                    Content="Save Changes"
                    Width="145"
                    Height="42"
                    Background="#D9A441"
                    Foreground="#101018"
                    BorderThickness="0"
                    FontWeight="Bold"
                    Click="btnSave_Click"/>
        </Grid>

    </Grid>
</Window>