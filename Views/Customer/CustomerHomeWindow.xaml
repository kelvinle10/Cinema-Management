<Window x:Class="CinemaManagementSystem.Views.Customer.CustomerHomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cinema - Customer Home"
        Height="750"
        Width="1200"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#101018"
        WindowState="Maximized">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#1C1C28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0"
                            Margin="15,35,15,40">
                    <TextBlock Text="CINEMA"
                               Foreground="#D9A441"
                               FontSize="27"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="CUSTOMER PORTAL"
                               Foreground="#AAAAAA"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="12,0">

                    <Border Background="#D9A441"
                            CornerRadius="7"
                            Padding="15,13"
                            Margin="0,0,0,10">
                        <TextBlock Text="Dashboard"
                                   Foreground="#101018"
                                   FontSize="14"
                                   FontWeight="Bold"/>
                    </Border>

                    <Button Content="Movies"
                            Height="45"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            FontSize="14"
                            Margin="0,0,0,5"/>

                    <Button Content="My Bookings"
                            Height="45"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            FontSize="14"
                            Margin="0,0,0,5"/>

                    <Button Content="My Profile"
                            Height="45"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            FontSize="14"
                            Margin="0,0,0,5"/>
                </StackPanel>

                <!-- Logout -->
                <Button Grid.Row="2"
                        Content="Logout"
                        Height="45"
                        Margin="12,15"
                        Background="#351F24"
                        Foreground="#E36B75"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="14"
                        Click="btnLogout_Click"/>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Margin="30,25,30,20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock Text="Welcome to Cinema!"
                               Foreground="White"
                               FontSize="27"
                               FontWeight="Bold"/>

                    <TextBlock Text="Find your favorite movie and book your tickets."
                               Foreground="#AAAAAA"
                               FontSize="14"
                               Margin="0,7,0,0"/>
                </StackPanel>
            </Grid>

            <!-- CONTENT -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <!-- FEATURED MOVIE -->
                    <Border x:Name="featuredPanel"
                            Height="210"
                            Background="#252535"
                            CornerRadius="12"
                            BorderBrush="#353545"
                            BorderThickness="1"
                            ClipToBounds="True"
                            Margin="0,0,0,30">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="0.8*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Movie Information -->
                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Margin="28,15">

                                <TextBlock Text="FEATURED MOVIE"
                                           Foreground="#D9A441"
                                           FontSize="12"
                                           FontWeight="Bold"/>

                                <TextBlock Text="{Binding Title}"
                                           Foreground="White"
                                           FontSize="27"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,8"/>

                                <TextBlock Text="{Binding Genre}"
                                           Foreground="#CCCCCC"
                                           FontSize="14"/>

                                <TextBlock Text="{Binding Description}"
                                           Foreground="#AAAAAA"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           MaxHeight="38"
                                           Margin="0,10,0,0"/>
                            </StackPanel>

                            <!-- Movie Poster -->
                            <Image Grid.Column="1"
                                   Source="{Binding PosterUrl}"
                                   Stretch="UniformToFill"/>
                        </Grid>
                    </Border>

                    <!-- NOW SHOWING HEADER -->
                    <TextBlock Text="NOW SHOWING"
                               Foreground="#D9A441"
                               FontSize="21"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <!-- NOW SHOWING MOVIES -->
                    <ItemsControl x:Name="icNowShowing"
                                  Margin="0,0,0,25">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="170"
                                        Background="#1C1C28"
                                        CornerRadius="10"
                                        Padding="10"
                                        Margin="0,0,15,15"
                                        BorderBrush="#303040"
                                        BorderThickness="1">

                                    <StackPanel>
                                        <Image Source="{Binding PosterUrl}"
                                               Height="185"
                                               Stretch="UniformToFill"/>

                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,10,0,5"/>

                                        <TextBlock Text="{Binding Genre}"
                                                   Foreground="#AAAAAA"
                                                   FontSize="12"/>

                                        <TextBlock Text="{Binding Duration, StringFormat={}{0} minutes}"
                                                   Foreground="#D9A441"
                                                   FontSize="12"
                                                   Margin="0,6,0,0"/>

                                        <Button Content="View Details"
                                                Height="32"
                                                Margin="0,10,0,0"
                                                Background="#D9A441"
                                                Foreground="#101018"
                                                FontWeight="Bold"
                                                BorderThickness="0"
                                                Click="btnViewDetails_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- COMING SOON HEADER -->
                    <TextBlock Text="COMING SOON"
                               Foreground="#D9A441"
                               FontSize="21"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <!-- COMING SOON MOVIES -->
                    <ItemsControl x:Name="icComingSoon"
                                  Margin="0,0,0,20">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="170"
                                        Background="#1C1C28"
                                        CornerRadius="10"
                                        Padding="10"
                                        Margin="0,0,15,15"
                                        BorderBrush="#303040"
                                        BorderThickness="1">

                                    <StackPanel>
                                        <Image Source="{Binding PosterUrl}"
                                               Height="185"
                                               Stretch="UniformToFill"/>

                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,10,0,5"/>

                                        <TextBlock Text="{Binding Genre}"
                                                   Foreground="#AAAAAA"
                                                   FontSize="12"/>

                                        <TextBlock Text="{Binding ReleaseDate, StringFormat={}{0:dd/MM/yyyy}}"
                                                   Foreground="#D9A441"
                                                   FontSize="12"
                                                   Margin="0,6,0,0"/>

                                        <Button Content="View Details"
                                                Height="32"
                                                Margin="0,10,0,0"
                                                Background="#D9A441"
                                                Foreground="#101018"
                                                FontWeight="Bold"
                                                BorderThickness="0"
                                                Click="btnViewDetails_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
