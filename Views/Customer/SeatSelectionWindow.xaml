<Window x:Class="CinemaManagementSystem.Views.Customer.SeatSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Seats"
        Height="750"
        Width="1000"
        MinHeight="650"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#101018">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Margin="0,0,0,25">
            <TextBlock Text="SELECT YOUR SEATS"
                       Foreground="#D9A441"
                       FontSize="26"
                       FontWeight="Bold"/>

            <TextBlock x:Name="txtShowtimeInfo"
                       Foreground="#AAAAAA"
                       FontSize="14"
                       Margin="0,10,0,0"/>
        </StackPanel>

        <!-- SEAT AREA -->
        <Border Grid.Row="1"
                Background="#1C1C28"
                CornerRadius="12"
                Padding="25">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">

                <StackPanel HorizontalAlignment="Center">

                    <!-- SCREEN -->
                    <Border Background="#D9A441"
                            Height="8"
                            Width="500"
                            CornerRadius="5"
                            Margin="0,10,0,10"/>

                    <TextBlock Text="SCREEN"
                               Foreground="#AAAAAA"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,35"/>

                    <!-- SEAT LEGEND -->
                    <WrapPanel HorizontalAlignment="Center"
                               Margin="0,0,0,30">

                        <StackPanel Orientation="Horizontal" Margin="10">
                            <Border Background="#444455"
                                    Width="18" Height="18"
                                    CornerRadius="4"/>
                            <TextBlock Text="Available"
                                       Foreground="White"
                                       Margin="7,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="10">
                            <Border Background="#D9A441"
                                    Width="18" Height="18"
                                    CornerRadius="4"/>
                            <TextBlock Text="Selected"
                                       Foreground="White"
                                       Margin="7,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="10">
                            <Border Background="#A94444"
                                    Width="18" Height="18"
                                    CornerRadius="4"/>
                            <TextBlock Text="Booked"
                                       Foreground="White"
                                       Margin="7,0,0,0"/>
                        </StackPanel>
                    </WrapPanel>

                    <!-- SEATS -->
                    <ItemsControl x:Name="icSeats">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5"
                                             HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding SeatName}"
                                            Width="48"
                                            Height="42"
                                            Margin="5"
                                            Background="{Binding SeatColor}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontWeight="Bold"
                                            Tag="{Binding SeatId}"
                                            IsEnabled="{Binding IsAvailable}"
                                            Click="btnSeat_Click">

                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="5">
                                                <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border"
                                                            Property="Opacity"
                                                            Value="0.8"/>
                                                </Trigger>

                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border"
                                                            Property="Opacity"
                                                            Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- FOOTER -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="txtSelectedSeats"
                           Text="Selected seats: 0"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="Bold"/>

                <TextBlock x:Name="txtTotalPrice"
                           Text="Total: 0 VND"
                           Foreground="#D9A441"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Continue"
                    Width="140"
                    Height="45"
                    Background="#D9A441"
                    Foreground="#101018"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="btnContinue_Click"/>
        </Grid>
    </Grid>
</Window>