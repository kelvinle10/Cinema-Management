<Window x:Class="CinemaManagementSystem.Views.Customer.MovieDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movie Details"
        Height="750"
        Width="1150"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#101018">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Button Content="← Back to Home"
                Width="140"
                Height="38"
                HorizontalAlignment="Left"
                Background="#252535"
                Foreground="White"
                BorderThickness="0"
                Click="btnBack_Click"
                Margin="0,0,0,25"/>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- MOVIE INFORMATION -->
                <Border Background="#1C1C28"
                        CornerRadius="12"
                        Padding="25"
                        Margin="0,0,0,30">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image x:Name="imgPoster"
                               Grid.Column="0"
                               Height="320"
                               Width="210"
                               Stretch="UniformToFill"/>

                        <StackPanel Grid.Column="1"
                                    Margin="30,10,10,10"
                                    VerticalAlignment="Center">

                            <TextBlock x:Name="txtTitle"
                                       Foreground="White"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"/>

                            <TextBlock x:Name="txtGenre"
                                       Foreground="#D9A441"
                                       FontSize="15"
                                       Margin="0,15,0,0"/>

                            <TextBlock x:Name="txtDuration"
                                       Foreground="#AAAAAA"
                                       FontSize="14"
                                       Margin="0,10,0,0"/>

                            <TextBlock x:Name="txtAgeRating"
                                       Foreground="#AAAAAA"
                                       FontSize="14"
                                       Margin="0,8,0,0"/>

                            <TextBlock x:Name="txtReleaseDate"
                                       Foreground="#AAAAAA"
                                       FontSize="14"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="DESCRIPTION"
                                       Foreground="#D9A441"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Margin="0,25,0,10"/>

                            <TextBlock x:Name="txtDescription"
                                       Foreground="White"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       MaxWidth="650"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- SHOWTIMES -->
                <TextBlock Text="AVAILABLE SHOWTIMES"
                           Foreground="#D9A441"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,15"/>

                <TextBlock Text="Choose a showtime to watch this movie."
                           Foreground="#AAAAAA"
                           FontSize="14"
                           Margin="0,0,0,15"/>

                <DataGrid x:Name="dgShowtimes"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          Background="#1C1C28"
          Foreground="White"
          BorderBrush="#333344"
          GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="#333344"
          RowBackground="#1C1C28"
          AlternatingRowBackground="#252535"
          HeadersVisibility="Column"
          Height="250"
          Margin="0,15,0,0">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#252535"/>
                            <Setter Property="Foreground" Value="#D9A441"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="BorderBrush" Value="#333344"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Room"
                        Binding="{Binding RoomName}"
                        Width="*"/>

                        <DataGridTextColumn Header="Start Time"
                        Binding="{Binding StartTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                        Width="2*"/>

                        <DataGridTextColumn Header="End Time"
                        Binding="{Binding EndTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                        Width="2*"/>

                        <DataGridTextColumn Header="Ticket Price"
                        Binding="{Binding TicketPrice, StringFormat={}{0:N0} VND}"
                        Width="*"/>

                        <DataGridTemplateColumn Header="Action" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Select Seats"
                        Tag="{Binding ShowtimeId}"
                        Background="#D9A441"
                        Foreground="#101018"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Padding="10,5"
                        Cursor="Hand"
                        Click="btnSelectSeats_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="txtNoShowtimes"
                           Text="No available showtimes at the moment."
                           Foreground="#AAAAAA"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,20"
                           Visibility="Collapsed"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
