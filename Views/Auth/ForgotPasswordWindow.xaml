<Window x:Class="CinemaManagementSystem.Views.Auth.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaManagementSystem.Views.Auth"
        mc:Ignorable="d"
        Title="Forgot Password - Cinema Management System"
        Height="600" Width="950"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#101018">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Left side -->
        <Grid Grid.Column="0">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <TextBlock Text="CINEMA"
                           FontSize="46"
                           FontWeight="Bold"
                           Foreground="#D9A441"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="MANAGEMENT SYSTEM"
                           FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,15"/>

                <TextBlock Text="Your Movie, Your Experience"
                           FontSize="14"
                           Foreground="#AAAAAA"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Right side -->
        <Border Grid.Column="1"
                Background="#1C1C28"
                CornerRadius="15"
                Margin="30"
                Padding="35">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Forgot Password?"
               FontSize="28"
               FontWeight="Bold"
               Foreground="White"
               Margin="0,0,0,8"/>

                <TextBlock Text="Enter your registered email to receive an OTP."
               FontSize="13"
               Foreground="#AAAAAA"
               TextWrapping="Wrap"
               Margin="0,0,0,30"/>

                <!-- Email section -->
                <StackPanel x:Name="EmailSection">

                    <TextBlock Text="Email Address"
                   Foreground="White"
                   Margin="0,0,0,8"/>

                    <TextBox x:Name="txtEmail"
                 Height="42"
                 FontSize="14"
                 Padding="10"
                 Background="#292938"
                 Foreground="White"
                 BorderBrush="#444455"
                 Margin="0,0,0,25"/>

                    <Button x:Name="btnSendOTP"
                Content="SEND OTP"
                Click="btnSendOTP_Click"
                Height="45"
                FontSize="16"
                FontWeight="Bold"
                Background="#D9A441"
                Foreground="#101018"
                BorderThickness="0"
                Cursor="Hand"/>
                </StackPanel>

                <!-- OTP section -->
                <StackPanel x:Name="OTPSection"
                Visibility="Collapsed">

                    <TextBlock Text="Verification Code"
                   Foreground="White"
                   Margin="0,0,0,8"/>

                    <TextBox x:Name="txtOTP"
                 Height="42"
                 FontSize="14"
                 Padding="10"
                 Background="#292938"
                 Foreground="White"
                 BorderBrush="#444455"
                 Margin="0,0,0,15"/>

                    <Button x:Name="btnVerifyOTP"
                Content="VERIFY OTP"
                Click="btnVerifyOTP_Click"
                Height="45"
                FontSize="16"
                FontWeight="Bold"
                Background="#D9A441"
                Foreground="#101018"
                BorderThickness="0"
                Cursor="Hand"/>

                    <TextBlock Text="Didn't receive the code? Resend OTP"
                   Foreground="#D9A441"
                   HorizontalAlignment="Center"
                   Cursor="Hand"
                   Margin="0,20,0,0"
                   MouseLeftButtonDown="ResendOTP_Click"/>
                </StackPanel>

                <!-- Reset Password Section -->
                <StackPanel x:Name="ResetPasswordSection"
                            Visibility="Collapsed">

                    <TextBlock Text="New Password"
                               Foreground="White"
                               Margin="0,0,0,8"/>

                    <PasswordBox x:Name="txtNewPassword"
                                 Height="42"
                                 FontSize="14"
                                 Padding="10"
                                 Background="#292938"
                                 Foreground="White"
                                 BorderBrush="#444455"
                                 Margin="0,0,0,20"/>

                    <TextBlock Text="Confirm New Password"
                               Foreground="White"
                               Margin="0,0,0,8"/>

                    <PasswordBox x:Name="txtConfirmNewPassword"
                                 Height="42"
                                 FontSize="14"
                                 Padding="10"
                                 Background="#292938"
                                 Foreground="White"
                                 BorderBrush="#444455"
                                 Margin="0,0,0,25"/>

                    <Button x:Name="btnResetPassword"
                            Content="RESET PASSWORD"
                            Click="btnResetPassword_Click"
                            Height="45"
                            FontSize="16"
                            FontWeight="Bold"
                            Background="#D9A441"
                            Foreground="#101018"
                            BorderThickness="0"
                            Cursor="Hand"/>

                </StackPanel>
                <TextBlock Text="Back to Login"
               Foreground="#D9A441"
               HorizontalAlignment="Center"
               Cursor="Hand"
               FontWeight="Bold"
               Margin="0,25,0,0"
               MouseLeftButtonDown="Login_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
