<Window x:Class="CinemaManagementSystem.Views.Auth.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register - Cinema Management System"
        Width="950"
        Height="760"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Background="#101018">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Left side: Brand -->
        <Grid Grid.Column="0">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <TextBlock Text="CINEMA"
                           FontSize="46"
                           FontWeight="Bold"
                           Foreground="#D9A441"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="MANAGEMENT SYSTEM"
                           FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,15"/>

                <TextBlock Text="Your Movie, Your Experience"
                           FontSize="14"
                           Foreground="#AAAAAA"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Right side: Register Form -->
        <Border Grid.Column="1"
                Background="#1C1C28"
                CornerRadius="15"
                Margin="25"
                Padding="22">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0"
                            Margin="0,0,0,15">

                    <TextBlock Text="Create Account"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Join us and enjoy your movies"
                               FontSize="13"
                               Foreground="#AAAAAA"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Form -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Full Name -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                        <TextBlock Text="Full Name"
                                   Foreground="White"
                                   FontSize="12"
                                   Margin="0,0,0,4"/>

                        <TextBox x:Name="txtFullName"
                                 Height="32"
                                 FontSize="14"
                                 Padding="10,5"
                                 Background="#292938"
                                 Foreground="White"
                                 BorderBrush="#444455"/>
                    </StackPanel>

                    <!-- Username -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Username"
                                   Foreground="White"
                                   FontSize="12"
                                   Margin="0,0,0,4"/>

                        <TextBox x:Name="txtUsername"
                                 Height="32"
                                 FontSize="14"
                                 Padding="10,5"
                                 Background="#292938"
                                 Foreground="White"
                                 BorderBrush="#444455"/>
                    </StackPanel>

                    <!-- Email -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Center">
                        <TextBlock Text="Email"
                                   Foreground="White"
                                   FontSize="12"
                                   Margin="0,0,0,4"/>

                        <TextBox x:Name="txtEmail"
                                 Height="32"
                                 FontSize="14"
                                 Padding="10,5"
                                 Background="#292938"
                                 Foreground="White"
                                 BorderBrush="#444455"/>
                    </StackPanel>

                    <!-- Phone -->
                    <StackPanel Grid.Row="3" VerticalAlignment="Center">
                        <TextBlock Text="Phone"
                                   Foreground="White"
                                   FontSize="12"
                                   Margin="0,0,0,4"/>

                        <TextBox x:Name="txtPhone"
                                 Height="32"
                                 FontSize="14"
                                 Padding="10,5"
                                 Background="#292938"
                                 Foreground="White"
                                 BorderBrush="#444455"/>
                    </StackPanel>

                    <!-- Date of Birth -->
                    <StackPanel Grid.Row="4" VerticalAlignment="Center">
                        <TextBlock Text="Date of Birth"
                                   Foreground="White"
                                   FontSize="12"
                                   Margin="0,0,0,4"/>

                        <DatePicker x:Name="dpDateOfBirth"
                                    Height="32"
                                    FontSize="13"
                                    Background="#292938"
                                    Foreground="#101018"/>
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Grid.Row="5" VerticalAlignment="Center">
                        <TextBlock Text="Password"
                                   Foreground="White"
                                   FontSize="12"
                                   Margin="0,0,0,4"/>

                        <PasswordBox x:Name="txtPassword"
                                     Height="32"
                                     FontSize="14"
                                     Padding="10,5"
                                     Background="#292938"
                                     Foreground="White"
                                     BorderBrush="#444455"/>
                    </StackPanel>

                    <!-- Confirm Password -->
                    <StackPanel Grid.Row="6" VerticalAlignment="Center">
                        <TextBlock Text="Confirm Password"
                                   Foreground="White"
                                   FontSize="12"
                                   Margin="0,0,0,4"/>

                        <PasswordBox x:Name="txtConfirmPassword"
                                     Height="32"
                                     FontSize="14"
                                     Padding="10,5"
                                     Background="#292938"
                                     Foreground="White"
                                     BorderBrush="#444455"/>
                    </StackPanel>

                    <!-- Register Button -->
                    <Button Grid.Row="7"
                            x:Name="btnRegister"
                            Content="REGISTER"
                            Click="btnRegister_Click"
                            Height="40"
                            FontSize="15"
                            FontWeight="Bold"
                            Background="#D9A441"
                            Foreground="#101018"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,10,0,0"/>

                    <!-- Login Link -->
                    <StackPanel Grid.Row="8"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0">

                        <TextBlock Text="Already have an account? "
                                   Foreground="#AAAAAA"
                                   FontSize="13"/>

                        <TextBlock Text="Login"
                                   Foreground="#D9A441"
                                   Cursor="Hand"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   MouseLeftButtonDown="Login_Click"/>
                    </StackPanel>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
