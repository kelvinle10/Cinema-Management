<Window x:Class="CinemaManagementSystem.Views.Auth.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register - Cinema Management System"
        Width="950"
        Height="760"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Background="#101018">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE: BRAND -->
        <Grid Grid.Column="0">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <TextBlock Text="CINEMA"
                           FontSize="46"
                           FontWeight="Bold"
                           Foreground="#D9A441"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="MANAGEMENT SYSTEM"
                           FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,15"/>

                <TextBlock Text="Your Movie, Your Experience"
                           FontSize="14"
                           Foreground="#AAAAAA"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- RIGHT SIDE: REGISTER FORM -->
        <Border Grid.Column="1"
                Background="#1C1C28"
                CornerRadius="15"
                Margin="25"
                Padding="22">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <StackPanel Grid.Row="0"
                            Margin="0,0,0,15">

                    <TextBlock Text="Create Account"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Join us and enjoy your movies"
                               FontSize="13"
                               Foreground="#AAAAAA"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- FORM -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- FULL NAME -->
                    <StackPanel Grid.Row="0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Full Name"
                                   Foreground="White"
                                   FontSize="12"
                                   Margin="0,0,0,4"/>

                        <TextBox x:Name="txtFullName"
                                 Height="32"
                                 FontSize="14"
                                 Padding="10,5"
                                 Background="#292938"
                                 Foreground="White"
                                 BorderBrush="#444455"/>
                    </StackPanel>

                    <!-- USERNAME -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center">

                        <TextBlock Text="Username"
                                   Foreground="White"
                                   FontSize="12"
                                   Margin="0,0,0,4"/>

                        <TextBox x:Name="txtUsername"
                                 Height="32"
                                 FontSize="14"
                                 Padding="10,5"
                                 Background="#292938"
                                 Foreground="White"
                                 BorderBrush="#444455"/>
                    </StackPanel>

                    <!-- EMAIL -->
                    <StackPanel Grid.Row="2"
                                VerticalAlignment="Center">

                        <TextBlock Text="Email"
                                   Foreground="White"
                                   FontSize="12"
                                   Margin="0,0,0,4"/>

                        <TextBox x:Name="txtEmail"
                                 Height="32"
                                 FontSize="14"
                                 Padding="10,5"
                                 Background="#292938"
                                 Foreground="White"
                                 BorderBrush="#444455"/>
                    </StackPanel>

                    <!-- PHONE -->
                    <StackPanel Grid.Row="3"
                                VerticalAlignment="Center">

                        <TextBlock Text="Phone"
                                   Foreground="White"
                                   FontSize="12"
                                   Margin="0,0,0,4"/>

                        <TextBox x:Name="txtPhone"
                                 Height="32"
                                 FontSize="14"
                                 Padding="10,5"
                                 Background="#292938"
                                 Foreground="White"
                                 BorderBrush="#444455"/>
                    </StackPanel>

                    <!-- DATE OF BIRTH -->
                    <StackPanel Grid.Row="4"
                                VerticalAlignment="Center">

                        <TextBlock Text="Date of Birth"
                                   Foreground="White"
                                   FontSize="12"
                                   Margin="0,0,0,4"/>

                        <DatePicker x:Name="dpDateOfBirth"
                                    Height="40"
                                    FontSize="15"
                                    Background="#292938"
                                    Foreground="White"
                                    BorderBrush="#444455"
                                    Padding="5">

                            <DatePicker.Resources>

                                <!-- DATE INPUT -->
                                <Style TargetType="{x:Type DatePickerTextBox}">
                                    <Setter Property="Background"
                                            Value="#292938"/>
                                    <Setter Property="Foreground"
                                            Value="White"/>
                                    <Setter Property="BorderBrush"
                                            Value="#444455"/>
                                    <Setter Property="CaretBrush"
                                            Value="White"/>
                                    <Setter Property="FontSize"
                                            Value="15"/>
                                    <Setter Property="Height"
                                            Value="32"/>
                                    <Setter Property="Padding"
                                            Value="8,4"/>
                                    <Setter Property="VerticalContentAlignment"
                                            Value="Center"/>
                                </Style>

                                <!-- CALENDAR -->
                                <Style TargetType="{x:Type Calendar}">
                                    <Setter Property="Background"
                                            Value="#1C1C28"/>
                                    <Setter Property="Foreground"
                                            Value="White"/>
                                </Style>

                                <!-- CALENDAR DAYS -->
                                <Style TargetType="{x:Type CalendarDayButton}">
                                    <Setter Property="Background"
                                            Value="#1C1C28"/>
                                    <Setter Property="Foreground"
                                            Value="White"/>
                                    <Setter Property="FontSize"
                                            Value="13"/>

                                    <Style.Triggers>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="#3A3A4D"/>
                                            <Setter Property="Foreground"
                                                    Value="#D9A441"/>
                                        </Trigger>

                                        <Trigger Property="IsSelected"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="#D9A441"/>
                                            <Setter Property="Foreground"
                                                    Value="#101018"/>
                                        </Trigger>

                                    </Style.Triggers>
                                </Style>

                                <!-- CALENDAR MONTH/YEAR BUTTONS -->
                                <Style TargetType="{x:Type CalendarButton}">
                                    <Setter Property="Background"
                                            Value="#1C1C28"/>
                                    <Setter Property="Foreground"
                                            Value="#D9A441"/>
                                </Style>

                                <!-- CALENDAR ITEM -->
                                <Style TargetType="{x:Type CalendarItem}">
                                    <Setter Property="Background"
                                            Value="#1C1C28"/>
                                    <Setter Property="Foreground"
                                            Value="White"/>
                                </Style>

                            </DatePicker.Resources>
                        </DatePicker>
                    </StackPanel>

                    <!-- PASSWORD -->
                    <StackPanel Grid.Row="5"
                                VerticalAlignment="Center">

                        <TextBlock Text="Password"
                                   Foreground="White"
                                   FontSize="12"
                                   Margin="0,0,0,4"/>

                        <PasswordBox x:Name="txtPassword"
                                     Height="32"
                                     FontSize="14"
                                     Padding="10,5"
                                     Background="#292938"
                                     Foreground="White"
                                     BorderBrush="#444455"/>
                    </StackPanel>

                    <!-- CONFIRM PASSWORD -->
                    <StackPanel Grid.Row="6"
                                VerticalAlignment="Center">

                        <TextBlock Text="Confirm Password"
                                   Foreground="White"
                                   FontSize="12"
                                   Margin="0,0,0,4"/>

                        <PasswordBox x:Name="txtConfirmPassword"
                                     Height="32"
                                     FontSize="14"
                                     Padding="10,5"
                                     Background="#292938"
                                     Foreground="White"
                                     BorderBrush="#444455"/>
                    </StackPanel>

                    <!-- REGISTER BUTTON -->
                    <Button Grid.Row="7"
                            x:Name="btnRegister"
                            Content="REGISTER"
                            Click="btnRegister_Click"
                            Height="40"
                            FontSize="15"
                            FontWeight="Bold"
                            Background="#D9A441"
                            Foreground="#101018"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,10,0,0"/>

                    <!-- LOGIN LINK -->
                    <StackPanel Grid.Row="8"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0">

                        <TextBlock Text="Already have an account? "
                                   Foreground="#AAAAAA"
                                   FontSize="13"/>

                        <TextBlock Text="Login"
                                   Foreground="#D9A441"
                                   Cursor="Hand"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   MouseLeftButtonDown="Login_Click"/>
                    </StackPanel>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
