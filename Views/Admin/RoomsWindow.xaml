<Window x:Class="CinemaManagementSystem.Views.Admin.RoomsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room Management"
        Height="750" Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#101018">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Button Content="← Back to Dashboard"
                Width="160"
                Height="35"
                HorizontalAlignment="Left"
                Margin="0,0,0,12"
                Background="#302C25"
                Foreground="#D9A441"
                BorderBrush="#D9A441"
                BorderThickness="1"
                FontWeight="Bold"
                Cursor="Hand"
                Click="btnBack_Click"/>

                <TextBlock Text="ROOM MANAGEMENT"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#D9A441"/>

                <TextBlock Text="Manage cinema rooms and seating capacity"
                   FontSize="14"
                   Foreground="#AAAAAA"
                   Margin="0,8,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
            Content="+ Add Room"
            Width="130"
            Height="42"
            VerticalAlignment="Bottom"
            Background="#D9A441"
            Foreground="#101018"
            FontWeight="Bold"
            BorderThickness="0"
            Cursor="Hand"
            Click="btnAddRoom_Click"/>
        </Grid>

        <!-- Search -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <TextBox x:Name="txtSearch"
             Height="42"
             Width="300"
             HorizontalAlignment="Left"
             VerticalContentAlignment="Center"
             Padding="12,0"
             FontSize="14"
             Background="#1C1C28"
             Foreground="White"
             BorderBrush="#444455"
             TextChanged="txtSearch_TextChanged"/>
        </Grid>

        <!-- Room DataGrid -->
        <DataGrid x:Name="dgRooms"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Background="#1C1C28"
                  Foreground="White"
                  BorderBrush="#444455"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#333344"
                  VerticalGridLinesBrush="#333344"
                  RowBackground="#1C1C28"
                  AlternatingRowBackground="#252535"
                  HeadersVisibility="Column">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#302C25"/>
                    <Setter Property="Foreground" Value="#D9A441"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Height" Value="45"/>
                    <Setter Property="BorderBrush" Value="#444455"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Room ID"
                                    Binding="{Binding RoomId}"
                                    Width="90"/>

                <DataGridTextColumn Header="Room Name"
                                    Binding="{Binding RoomName}"
                                    Width="*"/>

                <DataGridTextColumn Header="Capacity"
                                    Binding="{Binding Capacity}"
                                    Width="130"/>

                <DataGridTextColumn Header="Total Seats"
                                    Binding="{Binding TotalSeats}"
                                    Width="130"/>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding IsActive}"
                                    Width="120"/>

                <DataGridTemplateColumn Header="Actions" Width="250">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">

                                <Button Content="Edit"
                                        Width="55"
                                        Height="28"
                                        Margin="3"
                                        Background="#D9A441"
                                        Foreground="#101018"
                                        FontWeight="Bold"
                                        BorderThickness="0"
                                        Click="btnEditRoom_Click"/>

                                <Button Content="Delete"
                                        Width="65"
                                        Height="28"
                                        Margin="3"
                                        Background="#C0392B"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        BorderThickness="0"
                                        Click="btnDeleteRoom_Click"/>

                                <Button Content="Seats"
                                        Width="55"
                                        Height="28"
                                        Margin="3"
                                        Background="#34495E"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        BorderThickness="0"
                                        Click="btnManageSeats_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
