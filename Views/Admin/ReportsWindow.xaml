<Window x:Class="CinemaManagementSystem.Views.Admin.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reports"
        Height="700" Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#101018">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <StackPanel>
                <Button Content="← Back to Dashboard"
                        Width="170" Height="35"
                        HorizontalAlignment="Left"
                        Background="#252535"
                        Foreground="#D9A441"
                        BorderThickness="0"
                        Click="btnBack_Click"/>

                <TextBlock Text="REPORTS"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#D9A441"
                           Margin="0,18,0,5"/>

                <TextBlock Text="View cinema business statistics"
                           FontSize="14"
                           Foreground="#AAAAAA"/>
            </StackPanel>

            <Button Content="↻ Refresh Reports"
                    Width="160" Height="40"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#D9A441"
                    Foreground="#101018"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="btnRefresh_Click"/>
        </Grid>

        <!-- Total Revenue -->
        <Border Grid.Row="1"
                Background="#1C1C28"
                BorderBrush="#444455"
                BorderThickness="1"
                CornerRadius="10"
                Padding="25"
                Margin="0,0,0,25">

            <StackPanel>
                <TextBlock Text="TOTAL REVENUE"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#AAAAAA"/>

                <TextBlock x:Name="txtTotalRevenue"
                           Text="0 VND"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#D9A441"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Booking Statistics -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="BOOKING STATISTICS"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#D9A441"
                       Margin="0,0,0,15"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Bookings -->
                <Border Grid.Column="0"
                        Background="#252535"
                        BorderBrush="#D9A441"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="0,0,12,0"
                        Padding="25">

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TOTAL BOOKINGS"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#AAAAAA"/>

                        <TextBlock x:Name="txtTotalBookings"
                                   Text="0"
                                   FontSize="52"
                                   FontWeight="Bold"
                                   Foreground="#D9A441"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="All booking records"
                                   FontSize="13"
                                   Foreground="#888899"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Booking Status Cards -->
                <UniformGrid Grid.Column="1"
                             Columns="2"
                             Rows="2">

                    <!-- Pending -->
                    <Border Background="#30291C"
                            CornerRadius="10"
                            Margin="8"
                            Padding="22">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PENDING"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#E5B94C"/>

                            <TextBlock x:Name="txtPendingBookings"
                                       Text="0"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#E5B94C"
                                       Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Confirmed -->
                    <Border Background="#1C3028"
                            CornerRadius="10"
                            Margin="8"
                            Padding="22">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CONFIRMED"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#55C98A"/>

                            <TextBlock x:Name="txtConfirmedBookings"
                                       Text="0"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#55C98A"
                                       Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Cancelled -->
                    <Border Background="#351F24"
                            CornerRadius="10"
                            Margin="8"
                            Padding="22">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CANCELLED"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#E36B75"/>

                            <TextBlock x:Name="txtCancelledBookings"
                                       Text="0"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#E36B75"
                                       Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Expired -->
                    <Border Background="#292936"
                            CornerRadius="10"
                            Margin="8"
                            Padding="22">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="EXPIRED"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#A5A5B8"/>

                            <TextBlock x:Name="txtExpiredBookings"
                                       Text="0"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#A5A5B8"
                                       Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>
