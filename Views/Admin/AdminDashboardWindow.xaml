<Window x:Class="CinemaManagementSystem.Views.Admin.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Dashboard"
        Height="750"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#101018">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#1C1C28">

            <DockPanel>

                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top"
                            Margin="25,30,25,35">

                    <TextBlock Text="CINEMA"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#D9A441"/>

                    <TextBlock Text="MANAGEMENT SYSTEM"
                               FontSize="11"
                               Foreground="#AAAAAA"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Menu -->
                <StackPanel Margin="15,0">

                    <TextBlock Text="MAIN MENU"
                               Foreground="#777788"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="12,0,0,15"/>

                    <Button Content="Dashboard"
                            Background="#D9A441"
                            Foreground="#101018"
                            FontWeight="Bold"
                            Height="45"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            BorderThickness="0"
                            Margin="0,0,0,8"/>

                    <Button Content="Movies"
                            Background="Transparent"
                            Foreground="White"
                            Height="45"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            BorderThickness="0"
                            Margin="0,0,0,8"
                            Click="btnMovies_Click"/>

                    <Button Content="Rooms &amp; Seats"
                            Background="Transparent"
                            Foreground="White"
                            Height="45"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            BorderThickness="0"
                            Margin="0,0,0,8"
                            Click="btnRooms_Click"/>

                    <Button Content="Showtimes"
                            Background="Transparent"
                            Foreground="White"
                            Height="45"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            BorderThickness="0"
                            Margin="0,0,0,8"
                            Click="btnShowtimes_Click"/>

                    <Button Content="Bookings"
                            Background="Transparent"
                            Foreground="White"
                            Height="45"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            BorderThickness="0"
                            Margin="0,0,0,8"
                            Click="btnBookings_Click"/>

                    <Button Content="Customers"
                            Background="Transparent"
                            Foreground="White"
                            Height="45"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            BorderThickness="0"
                            Margin="0,0,0,8"
                            Click="btnCustomers_Click"/>

                    <Button Content="Reports"
                            Background="Transparent"
                            Foreground="White"
                            Height="45"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            BorderThickness="0"
                            Margin="0,0,0,8"/>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,30">

                <StackPanel>
                    <TextBlock Text="Dashboard"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Welcome back, Administrator!"
                               FontSize="14"
                               Foreground="#AAAAAA"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right"
            VerticalAlignment="Center">

                    <TextBlock Text="ADMIN"
               Foreground="#D9A441"
               FontWeight="Bold"
               HorizontalAlignment="Right"/>

                    <TextBlock Text="Administrator"
               Foreground="#AAAAAA"
               FontSize="12"
               Margin="0,5,0,8"
               HorizontalAlignment="Right"/>

                    <Button Content="Logout"
            Width="90"
            Height="30"
            Background="#30232A"
            Foreground="#E57373"
            BorderThickness="0"
            Cursor="Hand"
            Click="btnLogout_Click"/>

                </StackPanel>
            </Grid>

            <!-- Statistics Cards -->
            <UniformGrid Grid.Row="1"
                         Columns="4"
                         Margin="0,0,0,25">

                <Border Background="#1C1C28"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,15,0">

                    <StackPanel>
                        <TextBlock Text="TOTAL MOVIES"
                                   Foreground="#AAAAAA"
                                   FontSize="12"/>

                        <TextBlock Text="--"
                                   x:Name="txtTotalMovies"
                                   Foreground="#D9A441"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#1C1C28"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,15,0">

                    <StackPanel>
                        <TextBlock Text="TOTAL CUSTOMERS"
                                   Foreground="#AAAAAA"
                                   FontSize="12"/>

                        <TextBlock x:Name="txtTotalCustomers"
                                   Text="--"
                                   Foreground="#D9A441"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#1C1C28"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,15,0">

                    <StackPanel>
                        <TextBlock Text="TOTAL BOOKINGS"
                                   Foreground="#AAAAAA"
                                   FontSize="12"/>

                        <TextBlock Text="--"
                                   x:Name="txtTotalBookings"
                                   Foreground="#D9A441"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#1C1C28"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>
                        <TextBlock Text="TOTAL ROOMS"
                                   Foreground="#AAAAAA"
                                   FontSize="12"/>

                        <TextBlock Text="--"
                                   x:Name="txtTotalRooms"
                                   Foreground="#D9A441"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Revenue -->
            <Border Grid.Row="2"
                    Background="#1C1C28"
                    CornerRadius="12"
                    Padding="25"
                    Margin="0,0,0,25">

                <StackPanel>
                    <TextBlock Text="TOTAL REVENUE"
                               Foreground="#AAAAAA"
                               FontSize="13"/>

                    <TextBlock Text="-- VND"
                               x:Name="txtTotalRevenue"
                               Foreground="#D9A441"
                               FontSize="32"
                               FontWeight="Bold"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Bottom Content -->
            <Grid Grid.Row="3">

                <Border Background="#1C1C28"
                        CornerRadius="12"
                        Padding="25">

                    <StackPanel>
                        <TextBlock Text="Cinema Overview"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Your cinema statistics will appear here."
                                   Foreground="#AAAAAA"
                                   FontSize="14"
                                   Margin="0,15,0,0"/>
                    </StackPanel>

                </Border>

            </Grid>

        </Grid>
    </Grid>
</Window>
