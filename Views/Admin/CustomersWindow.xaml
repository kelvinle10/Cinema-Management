
<Window x:Class="CinemaManagementSystem.Views.Admin.CustomersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer Management"
        Height="700" Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#101018">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <StackPanel>
                <Button Content="← Back to Dashboard"
                        Width="170" Height="35"
                        HorizontalAlignment="Left"
                        Background="#252535"
                        Foreground="#D9A441"
                        BorderThickness="0"
                        Click="btnBack_Click"/>

                <TextBlock Text="CUSTOMER MANAGEMENT"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#D9A441"
                           Margin="0,18,0,5"/>

                <TextBlock Text="Manage customer accounts and information"
                           FontSize="14"
                           Foreground="#AAAAAA"/>
            </StackPanel>
        </Grid>

        <!-- Search -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtSearch"
                     Grid.Column="0"
                     Height="38"
                     Padding="10"
                     FontSize="14"
                     Background="#1C1C28"
                     Foreground="White"
                     BorderBrush="#444455"
                     TextChanged="txtSearch_TextChanged"/>

            <Button Content="Refresh"
                    Grid.Column="1"
                    Width="100"
                    Height="38"
                    Margin="10,0,0,0"
                    Background="#D9A441"
                    Foreground="#101018"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="btnRefresh_Click"/>
        </Grid>

        <!-- DataGrid -->
        <DataGrid x:Name="dgCustomers"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Background="#1C1C28"
                  Foreground="White"
                  BorderBrush="#444455"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#333344"
                  VerticalGridLinesBrush="#333344"
                  RowBackground="#1C1C28"
                  AlternatingRowBackground="#252535">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#302C25"/>
                    <Setter Property="Foreground" Value="#D9A441"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="BorderBrush" Value="#444455"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding CustomerId}"
                                    Width="55"/>

                <DataGridTextColumn Header="Full Name"
                                    Binding="{Binding FullName}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Username"
                                    Binding="{Binding Username}"
                                    Width="*"/>

                <DataGridTextColumn Header="Email"
                                    Binding="{Binding Email}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Phone"
                                    Binding="{Binding Phone}"
                                    Width="*"/>

                <DataGridTextColumn Header="Date of Birth"
                                    Binding="{Binding DateOfBirth, StringFormat={}{0:dd/MM/yyyy}}"
                                    Width="*"/>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="*"/>

                <DataGridTemplateColumn Header="Actions" Width="145">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">

                                <Button Content="{Binding ActionText}"
                                        Width="110"
                                        Margin="3"
                                        Background="#D9A441"
                                        Foreground="#101018"
                                        Click="btnToggleStatus_Click"/>

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
