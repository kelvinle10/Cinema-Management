<Window x:Class="CinemaManagementSystem.Views.Admin.ShowtimesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Showtime Management"
        Height="700" Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#101018">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <StackPanel>
                <Button Content="← Back to Dashboard"
                        Width="170" Height="35"
                        HorizontalAlignment="Left"
                        Background="#252535"
                        Foreground="#D9A441"
                        BorderThickness="0"
                        Click="btnBack_Click"/>

                <TextBlock Text="SHOWTIME MANAGEMENT"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#D9A441"
                           Margin="0,18,0,5"/>

                <TextBlock Text="Manage movie schedules and ticket prices"
                           FontSize="14"
                           Foreground="#AAAAAA"/>
            </StackPanel>

            <Button Content="+ Add Showtime"
                    Width="145" Height="38"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#D9A441"
                    Foreground="#101018"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="btnAddShowtime_Click"/>
        </Grid>

        <!-- Search -->
        <TextBox x:Name="txtSearch"
                 Grid.Row="1"
                 Height="38"
                 Margin="0,0,0,20"
                 Padding="10"
                 FontSize="14"
                 Background="#1C1C28"
                 Foreground="White"
                 BorderBrush="#444455"
                 TextChanged="txtSearch_TextChanged"/>

        <!-- DataGrid -->
        <DataGrid x:Name="dgShowtimes"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Background="#1C1C28"
                  Foreground="White"
                  BorderBrush="#444455"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#333344"
                  VerticalGridLinesBrush="#333344"
                  RowBackground="#1C1C28"
                  AlternatingRowBackground="#252535">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#302C25"/>
                    <Setter Property="Foreground" Value="#D9A441"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="BorderBrush" Value="#444455"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding ShowtimeId}"
                                    Width="55"/>

                <DataGridTextColumn Header="Movie"
                                    Binding="{Binding MovieTitle}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Room"
                                    Binding="{Binding RoomName}"
                                    Width="*"/>

                <DataGridTextColumn Header="Start Time"
                                    Binding="{Binding StartTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                    Width="2*"/>

                <DataGridTextColumn Header="End Time"
                                    Binding="{Binding EndTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Ticket Price"
                                    Binding="{Binding TicketPrice, StringFormat={}{0:N0} VND}"
                                    Width="*"/>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="*"/>

                <DataGridTemplateColumn Header="Actions" Width="145">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Button Content="Edit"
                                        Width="55"
                                        Margin="3"
                                        Background="#D9A441"
                                        Foreground="#101018"
                                        Click="btnEditShowtime_Click"/>

                                <Button Content="Delete"
                                        Width="65"
                                        Margin="3"
                                        Background="#8B3030"
                                        Foreground="White"
                                        Click="btnDeleteShowtime_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
