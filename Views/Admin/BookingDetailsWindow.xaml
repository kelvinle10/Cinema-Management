<Window x:Class="CinemaManagementSystem.Views.Admin.BookingDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Booking Details"
        Height="680"
        Width="780"
        MinHeight="620"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#101018">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="BOOKING DETAILS"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#D9A441"/>

            <TextBlock x:Name="txtBookingCode"
                       FontSize="14"
                       Foreground="#AAAAAA"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Booking Information -->
        <Border Grid.Row="1"
                Background="#1C1C28"
                BorderBrush="#444455"
                BorderThickness="1"
                CornerRadius="5"
                Padding="18"
                Margin="0,0,0,15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="CUSTOMER INFORMATION"
                           Foreground="#D9A441"
                           FontWeight="Bold"
                           FontSize="15"
                           Grid.ColumnSpan="2"
                           Margin="0,0,0,15"/>

                <StackPanel Grid.Row="1" Margin="0,0,10,12">
                    <TextBlock Text="Customer Name"
                               Foreground="#AAAAAA"/>
                    <TextBlock x:Name="txtCustomerName"
                               Foreground="White"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1"
                            Margin="0,0,0,12">
                    <TextBlock Text="Email"
                               Foreground="#AAAAAA"/>
                    <TextBlock x:Name="txtEmail"
                               Foreground="White"/>
                </StackPanel>

                <TextBlock Text="SHOWTIME INFORMATION"
                           Grid.Row="2"
                           Grid.ColumnSpan="2"
                           Foreground="#D9A441"
                           FontWeight="Bold"
                           FontSize="15"
                           Margin="0,5,0,12"/>

                <StackPanel Grid.Row="3" Margin="0,0,10,12">
                    <TextBlock Text="Movie"
                               Foreground="#AAAAAA"/>
                    <TextBlock x:Name="txtMovie"
                               Foreground="White"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="1"
                            Margin="0,0,0,12">
                    <TextBlock Text="Room"
                               Foreground="#AAAAAA"/>
                    <TextBlock x:Name="txtRoom"
                               Foreground="White"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,0,10,12">
                    <TextBlock Text="Start Time"
                               Foreground="#AAAAAA"/>
                    <TextBlock x:Name="txtStartTime"
                               Foreground="White"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="1"
                            Margin="0,0,0,12">
                    <TextBlock Text="Booking Time"
                               Foreground="#AAAAAA"/>
                    <TextBlock x:Name="txtBookingTime"
                               Foreground="White"/>
                </StackPanel>

                <TextBlock Text="PAYMENT INFORMATION"
                           Grid.Row="5"
                           Grid.ColumnSpan="2"
                           Foreground="#D9A441"
                           FontWeight="Bold"
                           FontSize="15"
                           Margin="0,5,0,12"/>
            </Grid>
        </Border>

        <!-- Tickets and Payment -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="TICKETS"
                           Foreground="#D9A441"
                           FontSize="15"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>


                <DataGrid x:Name="dgTickets"
          Height="190"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          Background="#1C1C28"
          Foreground="White"
          BorderBrush="#444455"
          GridLinesVisibility="All"
          HorizontalGridLinesBrush="#333344"
          VerticalGridLinesBrush="#333344"
          RowBackground="#1C1C28"
          AlternatingRowBackground="#252535">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#302C25"/>
                            <Setter Property="Foreground" Value="#D9A441"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="BorderBrush" Value="#444455"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="8"/>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ticket Code"
                            Binding="{Binding TicketCode}"
                            Width="1.5*"/>

                        <DataGridTextColumn Header="Seat"
                            Binding="{Binding SeatName}"
                            Width="*"/>

                        <DataGridTextColumn Header="Type"
                            Binding="{Binding SeatType}"
                            Width="*"/>

                        <DataGridTextColumn Header="Price"
                            Binding="{Binding Price, StringFormat={}{0:N0}}"
                            Width="*"/>

                        <DataGridTextColumn Header="Status"
                            Binding="{Binding Status}"
                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

            </StackPanel>

            <Border Grid.Row="1"
                    Background="#1C1C28"
                    Padding="15"
                    Margin="0,15,0,0"
                    CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Payment Method"
                                   Foreground="#AAAAAA"/>
                        <TextBlock x:Name="txtPaymentMethod"
                                   Foreground="White"/>
                        <TextBlock Text="Payment Time"
                                   Foreground="#AAAAAA"
                                   Margin="0,8,0,0"/>
                        <TextBlock x:Name="txtPaymentTime"
                                   Foreground="White"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Payment Status"
                                   Foreground="#AAAAAA"/>
                        <TextBlock x:Name="txtPaymentStatus"
                                   Foreground="White"/>
                        <TextBlock Text="Transaction Code"
                                   Foreground="#AAAAAA"
                                   Margin="0,8,0,0"/>
                        <TextBlock x:Name="txtTransactionCode"
                                   Foreground="White"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <TextBlock Text="Total Amount:"
                       Foreground="#AAAAAA"
                       FontSize="15"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <TextBlock x:Name="txtTotalAmount"
                       Foreground="#D9A441"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,25,0"/>

            <Button Content="Close"
                    Width="90"
                    Height="38"
                    Background="#302C35"
                    Foreground="White"
                    BorderThickness="0"
                    Click="btnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
