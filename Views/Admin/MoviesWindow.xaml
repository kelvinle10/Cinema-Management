<Window x:Class="CinemaManagementSystem.Views.Admin.MoviesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movie Management"
        Height="750"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#101018">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <StackPanel>
                <TextBlock Text="Movie Management"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Manage movies in your cinema"
                           FontSize="14"
                           Foreground="#AAAAAA"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Button Content="+ Add Movie"
                    Width="130"
                    Height="40"
                    HorizontalAlignment="Right"
                    Background="#D9A441"
                    Foreground="#101018"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="btnAddMovie_Click"/>
        </Grid>

        <!-- Search -->
        <TextBox x:Name="txtSearch"
                 Grid.Row="1"
                 Height="40"
                 Width="300"
                 HorizontalAlignment="Left"
                 VerticalContentAlignment="Center"
                 Padding="10,0"
                 Background="#1C1C28"
                 Foreground="White"
                 BorderBrush="#444455"
                 TextChanged="txtSearch_TextChanged"/>

        <!-- Movie List -->
        <DataGrid x:Name="dgMovies"
          Grid.Row="2"
          Margin="0,20,0,0"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          Background="#1C1C28"
          Foreground="White"
          RowBackground="#1C1C28"
          AlternatingRowBackground="#252535"
          BorderBrush="#333344"
          BorderThickness="1"
          GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="#333344"
          HeadersVisibility="Column"
          VerticalGridLinesBrush="#333344">

            <DataGrid.Resources>

                <!-- Column Header -->
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#302C25"/>
                    <Setter Property="Foreground" Value="#D9A441"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="12"/>
                    <Setter Property="BorderBrush" Value="#444455"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>

                <!-- Data Grid Cell -->
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="#333344"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#514329"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!-- Data Grid Row -->
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="#1C1C28"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Height" Value="45"/>

                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#302C25"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

            </DataGrid.Resources>

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                            Binding="{Binding MovieId}"
                            Width="60"/>

                <DataGridTextColumn Header="Title"
                            Binding="{Binding Title}"
                            Width="2*"/>

                <DataGridTextColumn Header="Genre"
                            Binding="{Binding Genre}"
                            Width="*"/>

                <DataGridTextColumn Header="Duration"
                            Binding="{Binding Duration}"
                            Width="100"/>

                <DataGridTextColumn Header="Age Rating"
                            Binding="{Binding AgeRating}"
                            Width="110"/>

                <DataGridTextColumn Header="Status"
                            Binding="{Binding Status}"
                            Width="120"/>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>