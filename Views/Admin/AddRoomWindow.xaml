<Window x:Class="CinemaManagementSystem.Views.Admin.AddRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Room"
        Height="430" Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#101018">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="ADD NEW ROOM"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#D9A441"/>

            <TextBlock Text="Enter cinema room information"
                       Foreground="#AAAAAA"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Room Name"
                       Foreground="#D9A441"
                       Margin="0,0,0,8"/>

            <TextBox x:Name="txtRoomName"
                     Height="40"
                     FontSize="14"
                     Padding="10"
                     VerticalContentAlignment="Center"
                     Background="#1C1C28"
                     Foreground="White"
                     BorderBrush="#444455"
                     Margin="0,0,0,20"/>

            <TextBlock Text="Capacity"
                       Foreground="#D9A441"
                       Margin="0,0,0,8"/>

            <TextBox x:Name="txtCapacity"
                     Height="40"
                     FontSize="14"
                     Padding="10"
                     VerticalContentAlignment="Center"
                     Background="#1C1C28"
                     Foreground="White"
                     BorderBrush="#444455"
                     Margin="0,0,0,20"/>

            <CheckBox x:Name="chkIsActive"
                      Content="Active"
                      IsChecked="True"
                      Foreground="White"
                      FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Cancel"
                    Width="90"
                    Height="38"
                    Margin="0,0,10,0"
                    Background="#444455"
                    Foreground="White"
                    BorderThickness="0"
                    Click="btnCancel_Click"/>

            <Button Content="Save"
                    Width="90"
                    Height="38"
                    Background="#D9A441"
                    Foreground="#101018"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="btnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
