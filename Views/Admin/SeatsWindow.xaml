<Window x:Class="CinemaManagementSystem.Views.Admin.SeatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seat Management"
        Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#101018">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <StackPanel>
                <Button Content="← Back to Rooms"
                        Width="150" Height="35"
                        HorizontalAlignment="Left"
                        Background="#252535"
                        Foreground="#D9A441"
                        BorderThickness="0"
                        Click="btnBack_Click"/>

                <TextBlock Text="SEAT MANAGEMENT"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#D9A441"
                           Margin="0,18,0,5"/>

                <TextBlock x:Name="txtRoomName"
                           Text="Manage seats in this room"
                           FontSize="14"
                           Foreground="#AAAAAA"/>
            </StackPanel>

            <Button Content="+ Add Seat"
                    Width="120" Height="38"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#D9A441"
                    Foreground="#101018"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="btnAddSeat_Click"/>
        </Grid>

        <!-- Search -->
        <TextBox x:Name="txtSearch"
                 Grid.Row="1"
                 Height="38"
                 Margin="0,0,0,20"
                 Padding="10"
                 FontSize="14"
                 Background="#1C1C28"
                 Foreground="White"
                 BorderBrush="#444455"
                 TextChanged="txtSearch_TextChanged"/>

        <!-- Seat DataGrid -->
        <DataGrid x:Name="dgSeats"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Background="#1C1C28"
                  Foreground="White"
                  BorderBrush="#444455"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#333344"
                  VerticalGridLinesBrush="#333344"
                  RowBackground="#1C1C28"
                  AlternatingRowBackground="#252535">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#302C25"/>
                    <Setter Property="Foreground" Value="#D9A441"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="BorderBrush" Value="#444455"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Seat ID"
                                    Binding="{Binding SeatId}"
                                    Width="*"/>

                <DataGridTextColumn Header="Row"
                                    Binding="{Binding SeatRow}"
                                    Width="*"/>

                <DataGridTextColumn Header="Seat Number"
                                    Binding="{Binding SeatNumber}"
                                    Width="*"/>

                <DataGridTextColumn Header="Seat Type"
                                    Binding="{Binding SeatType}"
                                    Width="*"/>

                <DataGridCheckBoxColumn Header="Active"
                                        Binding="{Binding IsActive}"
                                        Width="*"/>

                <DataGridTemplateColumn Header="Actions" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Button Content="Edit"
                                        Width="55"
                                        Margin="3"
                                        Background="#D9A441"
                                        Foreground="#101018"
                                        Click="btnEditSeat_Click"/>

                                <Button Content="Delete"
                                        Width="65"
                                        Margin="3"
                                        Background="#8B3030"
                                        Foreground="White"
                                        Click="btnDeleteSeat_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
