<Window x:Class="CinemaManagementSystem.Views.Admin.BookingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Booking Management"
        Height="700" Width="1350"
        WindowStartupLocation="CenterScreen"
        Background="#101018">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <StackPanel>
                <Button Content="← Back to Dashboard"
                        Width="170" Height="35"
                        HorizontalAlignment="Left"
                        Background="#252535"
                        Foreground="#D9A441"
                        BorderThickness="0"
                        Click="btnBack_Click"/>

                <TextBlock Text="BOOKING MANAGEMENT"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#D9A441"
                           Margin="0,18,0,5"/>

                <TextBlock Text="Manage customer bookings and payments"
                           FontSize="14"
                           Foreground="#AAAAAA"/>
            </StackPanel>
        </Grid>

        <!-- Search and Filter -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtSearch"
                     Grid.Column="0"
                     Height="38"
                     Margin="0,0,10,0"
                     Padding="10"
                     FontSize="14"
                     Background="#1C1C28"
                     Foreground="White"
                     BorderBrush="#444455"
                     VerticalContentAlignment="Center"
                     TextChanged="txtSearch_TextChanged"/>


            <ComboBox x:Name="cbStatusFilter"
          Grid.Column="1"
          Height="38"
          Background="#252535"
          Foreground="White"
          BorderBrush="#444455"
          BorderThickness="1"
          Padding="10,0"
          VerticalContentAlignment="Center"
          SelectionChanged="cbStatusFilter_SelectionChanged">

                <ComboBox.Template>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton
                    Focusable="False"
                    IsChecked="{Binding IsDropDownOpen,
                        Mode=TwoWay,
                        RelativeSource={RelativeSource TemplatedParent}}"
                    ClickMode="Press">

                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#252535"
                                    BorderBrush="#444455"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                            <Grid>
                                                <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="#D9A441"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter
                    Content="{TemplateBinding SelectionBoxItem}"
                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                    ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                    Margin="10,0,30,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    IsHitTestVisible="False"
                    TextElement.Foreground="White"/>

                            <Popup x:Name="Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Slide">

                                <Border Background="#252535"
                            BorderBrush="#444455"
                            BorderThickness="1"
                            MinWidth="{Binding ActualWidth,
                                RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </ComboBox.Template>

                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#252535"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10,8"/>

                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#D9A441"/>
                                <Setter Property="Foreground" Value="#101018"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>

                <ComboBoxItem Content="All Status" IsSelected="True"/>
                <ComboBoxItem Content="Pending"/>
                <ComboBoxItem Content="Confirmed"/>
                <ComboBoxItem Content="Cancelled"/>
                <ComboBoxItem Content="Expired"/>
            </ComboBox>

        </Grid>

        <!-- Booking DataGrid -->
        <DataGrid x:Name="dgBookings"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Background="#1C1C28"
                  Foreground="White"
                  BorderBrush="#444455"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#333344"
                  VerticalGridLinesBrush="#333344"
                  RowBackground="#1C1C28"
                  AlternatingRowBackground="#252535">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#302C25"/>
                    <Setter Property="Foreground" Value="#D9A441"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="BorderBrush" Value="#444455"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding BookingId}"
                                    Width="55"/>

                <DataGridTextColumn Header="Booking Code"
                                    Binding="{Binding BookingCode}"
                                    Width="1.3*"/>

                <DataGridTextColumn Header="Customer"
                                    Binding="{Binding CustomerName}"
                                    Width="1.5*"/>

                <DataGridTextColumn Header="Movie"
                                    Binding="{Binding MovieTitle}"
                                    Width="1.5*"/>

                <DataGridTextColumn Header="Showtime"
                                    Binding="{Binding StartTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                    Width="1.5*"/>

                <DataGridTextColumn Header="Total Amount"
                                    Binding="{Binding TotalAmount, StringFormat={}{0:N0} VND}"
                                    Width="1.3*"/>

                <DataGridTextColumn Header="Payment"
                                    Binding="{Binding PaymentStatus}"
                                    Width="*"/>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="*"/>

                <DataGridTemplateColumn Header="Actions" Width="145">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Button Content="Details"
                                        Width="60"
                                        Margin="3"
                                        Background="#D9A441"
                                        Foreground="#101018"
                                        Click="btnDetails_Click"/>


                                <Button Content="Cancel"
                                        Click="btnCancelBooking_Click"
                                        Padding="10,5"
                                        Background="#8B3030"
                                        Foreground="White"
                                        Cursor="Hand">

                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="IsEnabled" Value="True"/>
                                            <Setter Property="Opacity" Value="1"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}"
                             Value="Cancelled">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Status}"
                             Value="Expired">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
