<Window x:Class="CinemaManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaManagementSystem"
        mc:Ignorable="d"
        Title="Cinema Management System" Height="600" Width="850"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Background -->
        <Grid.Background>
            <ImageBrush ImageSource="/Images/cinema-background.jpg"
                        Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Dark overlay -->
        <Grid Background="#99071325">

            <!-- Login card -->
            <Border Width="480"
                    Padding="35"
                    CornerRadius="18"
                    Background="#EE111C2D"
                    BorderBrush="#526783"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="🎬"
                               FontSize="48"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Cinema Management System"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"
                               TextAlignment="Center"
                               Margin="0,10,0,5"/>

                    <TextBlock Text="Watch · Book · Enjoy"
                               FontSize="15"
                               Foreground="#B9C5D8"
                               HorizontalAlignment="Center"/>

                    <Separator Margin="0,25,0,25"
                               Background="#526783"/>

                    <TextBlock Text="Username"
                               Foreground="White"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="txtUsername"
                             Height="42"
                             FontSize="16"
                             Padding="10"
                             Background="#263348"
                             Foreground="White"
                             BorderBrush="#526783"
                             Margin="0,0,0,20"/>

                    <TextBlock Text="Password"
                               Foreground="White"
                               Margin="0,0,0,8"/>

                    <PasswordBox x:Name="txtPassword"
                                 Height="42"
                                 FontSize="16"
                                 Padding="10"
                                 Background="#263348"
                                 Foreground="White"
                                 BorderBrush="#526783"
                                 Margin="0,0,0,25"/>

                    <Button Content="LOGIN"
                            Height="48"
                            FontSize="17"
                            FontWeight="Bold"
                            Background="#FFD166"
                            Foreground="#111827"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnLogin_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
